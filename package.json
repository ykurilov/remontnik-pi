{
  "name": "remontnik-pi",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "check-pins": "node scripts/check-pins.mjs",
    "check-public": "node scripts/check-public.mjs",
    "check-history": "node scripts/check-history.mjs",
    "verify": "pnpm test && pnpm build && pnpm test:examples && pnpm typecheck && pnpm check-pins && pnpm check-public && pnpm check-history",
    "changeset": "changeset",
    "test:examples": "vitest run --config vitest.examples.config.ts",
    "bench": "vitest run --config vitest.perf.config.ts",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
