{
  "name": "@ykurilov/remontnik-doctor",
  "version": "0.1.2",
  "description": "Ремонтник Pi: врач — служба на сервере приложения, принимает случаи и лечит их",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "bin": {
    "remontnik-doctor": "./dist/cli/remontnik-doctor.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:crash": "vitest run --config ../../vitest.crash.config.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@ykurilov/remontnik-core": "workspace:*",
    "yaml": "2.9.1"
  }
}
