{
  "name": "@ykurilov/remontnik-paseo-bridge",
  "version": "0.1.8",
  "description": "Ремонтник Pi: мост Paseo — плагин на компьютере владельца, передаёт случаи врача агенту приложения",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "bin": {
    "remontnik-paseo": "./dist/server/cli/remontnik-paseo.js"
  },
  "files": ["dist", "paseo-plugin.json", "OVERVIEW.md", "index.server.ts", "server", "!server/**/*.test.ts"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ykurilov/remontnik-core": "workspace:*"
  },
  "devDependencies": {
    "@getpaseo/client": "0.13.0",
    "@getpaseo/plugin": "0.13.0"
  }
}
