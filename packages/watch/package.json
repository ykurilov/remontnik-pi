{
  "name": "@ykurilov/remontnik-watch",
  "version": "0.1.10",
  "description": "Ремонтник Pi: сторож внутри приложения — ловит сбои, шлёт тревогу в Telegram и надёжно доставляет случаи врачу",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent-chat": {
      "types": "./dist/agent-chat/index.d.ts",
      "import": "./dist/agent-chat/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p type-tests/tsconfig.json",
    "test:live": "vitest run --config ../../vitest.live.config.ts packages/watch",
    "bench": "pnpm --dir ../.. run bench packages/watch"
  },
  "dependencies": {
    "@ykurilov/remontnik-core": "workspace:*"
  },
  "devDependencies": {
    "@ykurilov/agent-chat-core": "0.87.3"
  }
}
